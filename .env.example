# Meta App configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v25.0

# Short-lived User Token from Graph API Explorer → run scripts/refresh_all_tokens.py
# After refresh this holds the long-lived user token (~60 days)
META_USER_ACCESS_TOKEN=replace_with_long_lived_user_token

# Target Facebook Page and linked Instagram Business account
META_PAGE_ID=your_facebook_page_id
META_PAGE_ACCESS_TOKEN=replace_with_page_access_token
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# Application settings
APP_ENV=development
APP_DEBUG=true
# Local / Render free default (ephemeral on Render Free redeploys/spin-down).
# Week reports and content descriptions are rows in this same file.
DATABASE_PATH=data/social_search.db
SYNC_PAGE_SIZE=100
# Business Discovery media.limit per HTTP call (default 25). Larger is not assumed cheaper.
DISCOVERY_MEDIA_PAGE_SIZE=25
REQUEST_TIMEOUT_SECONDS=30

# Maaike / Red Rock test entry: streamlit run app_maaike.py
# Separate SQLite file. Do not point this at data/social_search.db.
# MAAIKE_DATABASE_PATH=data/maaike_redrock.db
# Render Free (HAMSTER): no disk — use /tmp on the instance.
# MAAIKE_DATABASE_PATH=/tmp/maaike_redrock.db
# Empty DB boots from tracked seed: maaike/seed/hamster_redrock.json.gz (Red Rock only).
# Optional remote persist for Maaike edits after boot (GET+PUT HTTPS, HAMSTER-only URL):
# Free-tier lasting storage (HAMSTER-only private GitHub Contents; no secrets in package)
# MAAIKE_PERSIST_ENABLED=1
# MAAIKE_PERSIST_BACKUP_URL=https://api.github.com/repos/SandrinePr/hamster-persist/contents/hamster-maaike-backup.json
# MAAIKE_PERSIST_TOKEN=github_pat_or_classic_with_contents_write
# Optional: MAAIKE_PERSIST_PROVIDER=github
# Optional: MAAIKE_PERSIST_RESTORE_ALWAYS=1  (force restore even when local DB has rows)

# Exact callback for Streamlit Meta login (separate from the React/FastAPI callback).
# MAAIKE_OAUTH_REDIRECT_URI=http://127.0.0.1:8502/
# Optional Facebook Login for Business configuration. When set, login uses it
# instead of a raw permission list.
# Maaike/HAMSTER uses MAAIKE_META_APP_* only (never META_APP_ID / TAOL).
# MAAIKE_META_APP_ID=
# MAAIKE_META_APP_SECRET=
# MAAIKE_META_GRAPH_API_VERSION=v25.0
# MAAIKE_META_LOGIN_CONFIG_ID=
# React + FastAPI entry. Callback path is always /api/meta/callback.
# MAAIKE_FRONTEND_URL=https://127.0.0.1:5173
# MAAIKE_BACKEND_URL=https://127.0.0.1:8000
# MAAIKE_CORS_ORIGINS=https://127.0.0.1:5173
# MAAIKE_WEB_OAUTH_REDIRECT_URI=https://127.0.0.1:8000/api/meta/callback
# On Render: leave URLs empty to use RENDER_EXTERNAL_URL, or set them all to
# https://hamster-8zgq.onrender.com and
# MAAIKE_WEB_OAUTH_REDIRECT_URI=https://hamster-8zgq.onrender.com/api/meta/callback
# In Meta for Developers (app = MAAIKE_META_APP_ID on Render):
#   App Domains: hamster-8zgq.onrender.com
#   Valid OAuth Redirect URIs: https://hamster-8zgq.onrender.com/api/meta/callback
# If those are empty, the app falls back to RENDER_EXTERNAL_URL (injected by Render).
# Stable key that signs the session cookie. Set this locally so restarts keep sessions.
# Empty uses a temporary process key (OAuth mid-login then fails after restart).
# MAAIKE_SESSION_SECRET=
# Public hosting gate (optional but required on open internet). Empty = no gate.
# MAAIKE_BASIC_AUTH_USER=maaike
# MAAIKE_BASIC_AUTH_PASSWORD=
# Leave report auto-planning off until dates are agreed with Maaike.
# ENABLE_REPORT_PLANNING_SCHEDULER=0
#
# Maandelijks algemeen trendrapport (1e om 06:00 Europe/Amsterdam + inhaalrun):
# Beveiligd endpoint voor GitHub Actions / externe cron (Render Free wake-up):
# MAAIKE_CRON_SECRET=long-random-secret
# ENABLE_MONTHLY_TREND_PAID_AI=0
# MAAIKE_MONTHLY_TREND_ACTIVE_FROM=2026-12-01
# Endpoint: POST /api/report-planning/monthly-trend/trigger
# Header: X-Cron-Secret: <MAAIKE_CRON_SECRET>


# Gemini for klantrapport + trendrapport (OpenAI-compatible endpoint).
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash-lite
# AI_API_KEY=your-gemini-api-key

# Claude for postfeedback (Prepare/Execute). Required for paid post analysis.
# CLAUDE_API_KEY=your-anthropic-key
# CLAUDE_MODEL=claude-sonnet-4-5
# Optional alias if CLAUDE_API_KEY is empty: ANTHROPIC_API_KEY=

# Figma planning sync (server-side only). File key is set per client in the app.
# FIGMA_ACCESS_TOKEN=figu_...
