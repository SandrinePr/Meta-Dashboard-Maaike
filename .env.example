# Meta App configuration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v25.0

# Short-lived User Token from Graph API Explorer → run scripts/refresh_all_tokens.py
# After refresh this holds the long-lived user token (~60 days)
META_USER_ACCESS_TOKEN=replace_with_long_lived_user_token

# Target Facebook Page and linked Instagram Business account
META_PAGE_ID=your_facebook_page_id
META_PAGE_ACCESS_TOKEN=replace_with_page_access_token
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# Application settings
APP_ENV=development
APP_DEBUG=true
# Local / Render free default (ephemeral on Render redeploys).
# Week reports and content descriptions are rows in this same file.
# Point this at a lasting disk only after that disk exists. Do not invent a mount.
DATABASE_PATH=data/social_search.db
SYNC_PAGE_SIZE=100
# Business Discovery media.limit per HTTP call (default 25). Larger is not assumed cheaper.
DISCOVERY_MEDIA_PAGE_SIZE=25
REQUEST_TIMEOUT_SECONDS=30

# Maaike / Red Rock test entry: streamlit run app_maaike.py
# Separate SQLite file. Do not point this at data/social_search.db.
# MAAIKE_DATABASE_PATH=data/maaike_redrock.db
# Exact callback for Maaike's Meta login. Register that same address in the Meta app.
# MAAIKE_OAUTH_REDIRECT_URI=http://127.0.0.1:8502/
# Optional Facebook Login for Business configuration. When set, login uses it
# instead of a raw permission list.
# Maaike gebruikt een eigen Meta-app. Vul hier niet de TAOL-app of TAOL-tokens in.
# MAAIKE_META_APP_ID=
# MAAIKE_META_APP_SECRET=
# MAAIKE_META_GRAPH_API_VERSION=v25.0
# MAAIKE_META_LOGIN_CONFIG_ID=
# React + FastAPI entry. The callback below is separate from the Streamlit page.
# MAAIKE_FRONTEND_URL=http://127.0.0.1:5173
# MAAIKE_BACKEND_URL=http://127.0.0.1:8000
# MAAIKE_CORS_ORIGINS=http://127.0.0.1:5173
# MAAIKE_WEB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/meta/callback
# Stable key that signs the session cookie. Set this locally so restarts keep sessions.
# Empty uses a temporary process key (OAuth mid-login then fails after restart).
# MAAIKE_SESSION_SECRET=

# Local image test for Gemini 3.5 Flash-Lite.
# The app calls {AI_BASE_URL}/chat/completions. Put the secret only in .env.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash-lite
# AI_API_KEY=your-gemini-api-key
